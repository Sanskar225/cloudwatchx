# ─── Backend Environment Variables ───────────────────────────
# Copy to backend/.env

NODE_ENV=development
PORT=4000

# Database (local dev)
DATABASE_URL=postgresql://cwx_user:cwx_password_change_me@localhost:5432/cloudwatchx

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cwx_redis_password

# JWT (generate with: openssl rand -hex 64)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production

# CORS
FRONTEND_URL=http://localhost:3000

# Monitoring stack
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_HOST=localhost
GRAFANA_HOST=localhost
ALERTMANAGER_HOST=localhost

# Notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000/xxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# ALERT_EMAIL_TO=oncall@yourcompany.com

# ─── Frontend (.env.local) ───────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_WS_URL=http://localhost:4000
